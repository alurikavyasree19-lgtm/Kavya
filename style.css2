/* Basic reset and font */
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Poppins',sans-serif;line-height:1.45;color:#222}

:root{
  --accent:#4b6cff;
  --accent-2:#1296db;
  --bg:#f5f9fc;
  --muted:#6b7280;
}

/* Header nav */
.nav{display:flex;gap:18px;align-items:center}
.nav a{color:var(--muted);text-decoration:none;font-weight:600}
.nav a:hover{color:var(--accent)}
.menu{cursor:pointer;display:none;font-size:22px}

/* Hero content layout */
.hero-content{max-width:720px;margin:0 auto;text-align:left;display:flex;flex-direction:column;gap:20px}

.photo-and-qual{display:flex;align-items:center;gap:20px}
.hero h2{font-size:36px;margin-bottom:8px}
.tagline{color:rgba(255,255,255,0.85);font-size:16px}

/* Button polish */
.btn.primary{background:var(--accent);color:#fff;border-radius:8px;padding:10px 18px}
.btn.primary:hover{filter:brightness(0.95)}
.btn.outline{background:transparent;border:2px solid rgba(255,255,255,0.15);color:#fff}

@media (max-width:800px){
  .nav{display:none}
  .menu{display:block}
  .nav.open{display:flex;flex-direction:column;position:absolute;top:64px;right:20px;background:#fff;padding:12px;border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,0.12)}
  .nav.open a{color:#000}
  .hero-content{text-align:center}
}


/* HERO LAYOUT */
.hero{position:relative;padding:80px 20px;max-width:1100px;margin:0 auto}

/* Photo beside the name */
.photo{width:80px;height:80px;border-radius:50%;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,0.12);background:#fff;flex-shrink:0}
.photo img{width:100%;height:100%;object-fit:cover;display:block}

/* Make sure hero content doesn't sit underneath the fixed photo */
.hero h2,.hero .tagline,.hero .buttons{}

/* Buttons spacing */
.buttons{margin-top:18px}

/* Responsive adjustments */
@media (max-width:900px){
  .hero{}
  .photo{}
}

@media (max-width:600px){
  /* On very small screens, stack the photo and content */
  .hero-content{flex-direction:column;text-align:center}
  .photo-and-qual{flex-direction:column;gap:10px}
  .photo{margin:0 auto}
  .hero{padding-right:20px}
  .hero h2,.hero .tagline,.hero .buttons{}
}
{
/* Card styles used for About / Certifications / Projects / Achievements */
.card{background:#fff;padding:20px;border-radius:10px;box-shadow:0 8px 20px rgba(0,0,0,0.06);margin:20px 0}
.card h3{margin:0 0 8px;font-size:1.25rem}
.project-card .project-list,.card .cert-list,.card .ach-list{margin-left:18px}
.project-underline,.cert-underline,.about-underline,.education-underline{
  width:70px;
  height:4px;
  background:#1296db; /* BLUE */
  margin:12px auto 30px;
  border-radius:10px;
}

/* Small tweak for project heading icon (if used) */
.project-heading i{margin-right:8px;color:#4b6cff}

@media (prefers-color-scheme:dark){
  body{background:#0f1724;color:#e6eef8}
  .card{background:#071022}
}

  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:'Poppins',sans-serif;
}

body{
  background:#f5f9fc;
}

/* ================= HEADER ================= */
.header{
  background:#fff;
  padding:15px 20px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.header span{
  color:#180daf;
}

/* ================= HERO ================= */
.hero{
  background:linear-gradient(135deg,#0c014b,#c412db);
  text-align:center;
  padding:60px 20px;
  color:#fff;
}

/* Profilo photo */
.photo{
  width:250px;              /* increased slightly to fit hair */
  height:340px;
  margin:0 auto 30px;
  border-radius:50%;
  border:6px solid rgba(255,255,255,0.5);
  display:flex;
  align-items:center;
  justify-content:center;
}

.photo img{
  width:100%;
  height:100%;
  border-radius:50%;
  object-fit:cover;
  /* move focal point up so head and hair are visible */
  object-position:50% 20%;
}

/* Responsive: make photo smaller on narrow screens */
@media (max-width:480px){
  .photo{ width:140px; height:140px; border-width:5px; }
}


/*-- buttons --*/
.btn{
  padding:12px 25px;
  border-radius:30px;
  border:none;
  cursor:pointer;
  margin:5px;
  font-size:14px;
}

.primary{
  background:#4a08b4;
  color:#230331;
}

.outline{
  background:transparent;
  border:2px solid #fff;
  color:#fff;
}

/* ================= SECTIONS ================= */
.section{
  padding:50px 20px;
  max-width:1100px;
  margin:auto;
}

.section h3,
.section h4,
.section p{
  text-align:center;
}

/* ================= TICK MARK LIST STYLE ================= */
.section ul{
  list-style:none;       /* remove dots */
  padding:0;
  margin-top:20px;
}

.section ul li{
  position:relative;
  padding-left:30px;
  margin-bottom:12px;
  text-align:left;
  display:inline-block;
  width:100%;
}

.section ul li::before{
  content:"✓";
  position:absolute;
  left:0;
  color:#392b8d;
  font-weight:700;
}

/* ================= SKILLS GRID ================= */
.skills-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:30px;
  justify-items:center;
}

/* ================= CONTACT SECTION ================= */
.contact-section{
  background:#2c3e50;
  color:#fff;
  border-radius:20px;
}

.contact-section h3{
  text-align:center;
}

.underline{
  width:60px;
  height:4px;
  background:#1296db;
  margin:10px auto 30px;
  border-radius:10px;
}

.contact-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:30px;
}

/* ================= CONTACT INFO ================= */
.contact-info h4{
  color:#1296db;
  margin-bottom:25px;
}

.contact-row{
  display:flex;
  align-items:center;
  gap:20px;
  margin-bottom:25px;
}

.contact-row i{
  font-size:22px;
  color:#1296db;
  min-width:30px;
}

.contact-text span{
  font-weight:600;
}

.contact-text p{
  margin-top:5px;
}

/* ================= SOCIAL ICONS ================= */
.social-icons a{
  display:inline-block;
  width:45px;
  height:45px;
  background:rgba(255,255,255,0.15);
  border-radius:50%;
  text-align:center;
  line-height:45px;
  margin-right:10px;
  color:#fff;
  font-size:20px;
}

/* ================= CARDS ================= */
.card{
  background:#fff;
  color:#000;
  padding:25px;
  border-radius:15px;
}

/* ================= MESSAGE BOX ================= */
.message-box{
  background:#1f3b4d;
  color:#fff;
}

.message-box input,
.message-box textarea{
  width:100%;
  padding:12px;
  margin:10px 0;
  border-radius:8px;
  border:none;
}

.send-btn{
  width:100%;
  padding:12px;
  background:#fff;
  color:#1296db;
  border-radius:25px;
  border:none;
  font-weight:600;
  cursor:pointer;
}

/* ================= FOOTER ================= */
footer{
  background:#0a6fa3;
  color:#fff;
  text-align:center;
  padding:20px;
}
/* ================= SKILLS SECTION ================= */

.skill-card{
  background:#fff;
  padding:30px;
  border-radius:18px;
  box-shadow:0 10px 25px rgba(0,0,0,0.08);
  transition:transform 0.3s ease;
}

.skill-card:hover{
  transform:translateY(-5px);
}

.skill-card h4{
  color:#1296db;
  margin-bottom:20px;
  font-size:20px;
  display:flex;
  align-items:center;
  gap:10px;
}

.skill-card ul{
  list-style:none;
  padding:0;
}

.skill-card ul li{
  position:relative;
  padding-left:30px;
  margin-bottom:14px;
  font-size:15px;
}

.skill-card ul li::before{
  content:"✓";
  position:absolute;
  left:0;
  color:#1296db;
  font-weight:700;
}
/* ================= ABOUT ME CARD ================= */

.about-card{
  background:#fff;
  padding:35px 30px;
  border-radius:18px;
  max-width:900px;
  margin:auto;
  box-shadow:0 12px 30px rgba(0,0,0,0.08);
  text-align:center;
}

.about-title{
  color:#222;          /* black heading */
  font-size:28px;
  font-weight:600;
}

.about-underline{
  width:70px;
  height:4px;
  background:#1296db;  /* blue underline */
  margin:12px auto 25px;
  border-radius:10px;
}

.about-card p{
  font-size:16px;
  line-height:1.8;
  color:#555;
}

/* ===== EDUCATION SECTION ===== */

.education-card{
  background:#fff;
  padding:35px 30px;
  border-radius:18px;
  max-width:900px;
  margin:auto;
  text-align:center;
  box-shadow:0 12px 30px rgba(0,0,0,0.08);
}

.education-heading{
  font-size:30px;
  font-weight:600;
  color:#222; /* BLACK */
}

/* underline EXACTLY centered */
.education-underline{
  width:70px;
  height:4px;
  background:#1296db; /* BLUE */
  margin:12px auto 30px;
  border-radius:10px;
}

.degree{
  font-size:20px;
  color:#333;
  margin-bottom:12px;
}

.college{
  font-size:16px;
  color:#555;
  margin-bottom:20px;
}

.edu-line{
  font-size:16px;
  margin-bottom:8px;
}

/* labels BLACK */
.label{
  color:#000;
  font-weight:500;
}

/* values BLUE */
.highlight{
  color:#1296db;
  font-weight:600;
}

/* ===== CERTIFICATIONS UNDERLINE ===== */

.cert-heading{
  font-size:28px;
  font-weight:600;
  color:#000; /* BLACK */
  text-align:center;
}

/* blue underline exactly in middle */
.cert-underline{
  width:80px;
  height:4px;
  background:#1296db; /* BLUE */
  margin:10px auto 25px;
  border-radius:10px;
}

.cert-list{
  list-style:none;
  padding:0;
}

.cert-list li{
  font-size:16px;
  margin-bottom:12px;
  position:relative;
  padding-left:28px;
}

/* blue tick marks */
.cert-list li::before{
  content:"✓";
  color:#1296db;
  font-weight:bold;
  position:absolute;
  left:0;
}

/* ===== PROJECTS SECTION (mirror certifications) ===== */

.projects-heading{
  font-size:28px;
  font-weight:600;
  color:#000; /* BLACK */
  text-align:center;
}

.projects-underline{
  width:80px;
  height:4px;
  background:#1296db; /* BLUE */
  margin:10px auto 25px;
  border-radius:10px;
}

.projects-list{
  list-style:none;
  padding:0;
}

.projects-list li{
  font-size:16px;
  margin-bottom:12px;
  position:relative;
  padding-left:28px;
}

.projects-list li::before{
  content:"✓";
  color:#1296db;
  font-weight:bold;
  position:absolute;
  left:0;
}

/* ===== PROJECTS CARD (match About / Education) ===== */
.projects-card{
  background:#fff;
  padding:35px 30px;
  border-radius:18px;
  max-width:900px;
  margin:auto;
  text-align:center;
  box-shadow:0 12px 30px rgba(0,0,0,0.08);
}

/* Make project list items visually match other sections (no tick) */
.projects-list{
  list-style:none;
  padding:0;
  text-align:left;
}

.projects-list li{
  font-size:16px;
  margin-bottom:12px;
  position:relative;
  padding-left:0;
}

.projects-list li::before{
  content:none;
}

/* ===== ACHIEVEMENTS SECTION ===== */

.ach-heading{
  font-size:28px;
  font-weight:600;
  color:#000; /* BLACK */
  text-align:center;
}

/* blue underline centered */
.ach-underline{
  width:80px;
  height:4px;
  background:#1296db; /* BLUE */
  margin:10px auto 25px;
  border-radius:10px;
}

.ach-list{
  list-style:none;
  padding:0;
}

.ach-list li{
  font-size:16px;
  margin-bottom:12px;
  position:relative;
  padding-left:28px;
}

/* blue tick marks */
.ach-list li::before{
  content:"✓";
  color:#1296db;
  font-weight:bold;
  position:absolute;
  left:0;
}